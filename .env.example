# ── Copy this file to .env and fill in real values ─────────────────────────
# cp .env.example .env

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-50-char-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Comma-separated — add your EC2 public IP and/or domain
ALLOWED_HOSTS=selections.pk,www.selections.pk,13.61.4.241

# ── Database ────────────────────────────────────────────────────────────────
DB_NAME=selections_db
DB_USER=selections_user
DB_PASSWORD=change-this-strong-password
DB_HOST=db
DB_PORT=5432

# ── CORS & CSRF (must match your actual frontend URL) ───────────────────────
CORS_ALLOWED_ORIGINS=https://selections.pk,https://www.selections.pk
CSRF_TRUSTED_ORIGINS=https://selections.pk,https://www.selections.pk

# ── Email (optional — leave blank to skip) ──────────────────────────────────
# ANYMAIL_API_KEY=your-mailgun-or-sendgrid-key
# DEFAULT_FROM_EMAIL=noreply@selections.pk
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend

# ── AWS S3 Media Storage (optional — set True to use S3) ───────────────────
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
